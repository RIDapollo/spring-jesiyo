<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- XML Mapper -->
<mapper namespace="location">

	<insert id="add">
		insert into location (seq, sido, sigungu, dong, lat, lng) values
			(location_seq.nextval, #{sido}, #{sigungu}, #{dong}, #{lat}, #{lng})
	</insert>
	
	<select id="findBySeq" parameterType="string" resultType="com.test.jesiyo.location.dto.LocationDto">
		select *
		from location
		where seq = #{seq}
	</select>
	
	<select id="findByDong" parameterType="string" resultType="com.test.jesiyo.location.dto.LocationDto">
		select *
		from location
		where dong = #{dong}
	</select>
	
	<!-- 기존 동네 삭제 (회원) -->
    <delete id="deleteMemberLocation" parameterType="string">
        DELETE FROM member_location
        WHERE member_seq = #{memberSeq}
    </delete>

    <!-- 새로운 동네 등록 (회원) -->
    <insert id="insertMemberLocation" parameterType="map">
        INSERT INTO member_location (seq, member_seq, location_seq)
        VALUES (member_location_seq.nextval, #{memberSeq}, #{locationSeq})
    </insert>

</mapper>