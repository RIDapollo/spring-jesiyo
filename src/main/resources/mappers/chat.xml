<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="chat">

    <select id="getChatRoomList" parameterType="String" resultType="com.test.jesiyo.chat.dto.ChatRoomDto">
        select * from chat_room where MEMBER_SEQ = #{_parameter}
    </select>
    

</mapper>